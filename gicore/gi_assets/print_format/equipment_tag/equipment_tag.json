 "font_size": 12,
 "html": "\n<style>\n.gi-pf{font-family:'Segoe UI',Tahoma,Arial,sans-serif;color:#111827;font-size:12px}\n.gi-pf .hd{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #4f46e5;padding-bottom:10px;margin-bottom:14px}\n.gi-pf .hd h1{margin:0;font-size:20px;color:#3730a3}\n.gi-pf .hd .ar{font-size:15px;color:#6b7280;margin-top:2px;direction:rtl}\n.gi-pf .meta{text-align:right;font-size:11px;color:#374151;line-height:1.6}\n.gi-pf .meta b{font-size:14px;color:#111827}\n.gi-pf .sec{background:#eef2ff;color:#3730a3;font-weight:700;padding:5px 10px;border-radius:6px;margin:14px 0 6px;font-size:12px}\n.gi-pf .grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 24px}\n.gi-pf .cell{border-bottom:1px dotted #d1d5db;padding:3px 0}\n.gi-pf .cell span{display:block;font-size:10px;color:#6b7280;text-transform:uppercase;letter-spacing:.4px}\n.gi-pf .cell b{font-weight:600}\n.gi-pf .full{grid-column:1/3}\n.gi-pf table.t{width:100%;border-collapse:collapse;margin-top:4px}\n.gi-pf table.t th{background:#4f46e5;color:#fff;padding:5px 7px;font-size:11px;text-align:start}\n.gi-pf table.t td{border:1px solid #e5e7eb;padding:5px 7px}\n.gi-pf table.t tr:nth-child(even) td{background:#f9fafb}\n.gi-pf .terms{margin-top:14px;padding:8px 10px;border:1px solid #e5e7eb;border-radius:6px;font-size:11px;color:#374151;line-height:1.7}\n.gi-pf .sig{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:46px}\n.gi-pf .sig div{border-top:1px solid #111827;padding-top:5px;text-align:center;font-size:11px}\n.gi-pf .sig small{display:block;color:#6b7280}\n.gi-pf .ft{margin-top:18px;font-size:9px;color:#9ca3af;text-align:center}\n</style>\n\n<style>.gi-tag{width:90mm;border:2px solid #4f46e5;border-radius:10px;padding:8px 10px;font-family:'Segoe UI',Arial,sans-serif}\n.gi-tag .co{font-size:10px;color:#6b7280;text-transform:uppercase;letter-spacing:1px}\n.gi-tag .id{font-size:22px;font-weight:800;color:#3730a3;letter-spacing:1px}\n.gi-tag .nm{font-size:13px;font-weight:600;margin:2px 0 4px}\n.gi-tag .ln{font-size:11px;color:#374151;line-height:1.5}</style>\n<div class=\"gi-tag\">\n <div class=\"co\">Asset Tag · بطاقة أصل</div>\n <div class=\"id\">{{ doc.name }}</div>\n <div class=\"nm\">{{ doc.equipment_name }}</div>\n <div class=\"ln\">\n  {% if doc.brand or doc.model %}{{ doc.brand or \"\" }} {{ doc.model or \"\" }}<br>{% endif %}\n  {% if doc.serial_no %}S/N: {{ doc.serial_no }}<br>{% endif %}\n  {{ doc.category or \"\" }}\n </div>\n</div>\n",
